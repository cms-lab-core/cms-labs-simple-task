{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["images", "clabgate", "frontend", "database", "jwt"],
  "properties": {
    "images": {
      "type": "object",
      "required": ["mysql", "backend", "clabgate", "frontend"]
    },
    "clabgate": {
      "type": "object",
      "required": ["taskRepository", "taskBranch", "jupyterImage", "checkerImage"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "taskRepository": {"type": "string", "minLength": 1},
        "taskBranch": {"type": "string", "minLength": 1},
        "jupyterImage": {"type": "string", "pattern": ":latest$"},
        "checkerImage": {"type": "string", "pattern": ":latest$"},
        "workspaceGrantTTLSeconds": {"type": "integer", "minimum": 60}
      }
    },
    "frontend": {
      "type": "object",
      "required": ["nodePort"],
      "properties": {
        "nodePort": {"type": "integer", "minimum": 30000, "maximum": 32767}
      }
    },
    "database": {
      "type": "object",
      "required": ["name", "user", "password"]
    },
    "jwt": {
      "type": "object",
      "required": ["secretName"]
    }
  }
}
