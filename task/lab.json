{
  "apiVersion": "cms.labs/v1",
  "kind": "Lab",
  "metadata": {
    "name": "simple-task",
    "moduleId": "task"
  },
  "spec": {
    "title": "Пример задания: автоматизация SSH и мониторинг SNMP",
    "description": "Настройка Linux-based сетевых узлов из Jupyter Notebook и автоматическая проверка результата.",
    "types": {
      "subject": "network-lab",
      "interface": "jupyter-notebook",
      "topology": [
        "containerlab",
        "clabernetes"
      ],
      "assessment": "automatic-checker"
    },
    "execution": [
      "github-codespaces",
      "local-devcontainer",
      "clabgate-kubernetes"
    ],
    "labPath": "task/task.ipynb",
    "testPath": "sdn_lab_5",
    "topologyPath": "task/topology.template.yaml",
    "runtime": {
      "jupyterImage": "ghcr.io/maintainer64/cms-labs-jupyter:1.0.0",
      "checkerImage": "ghcr.io/maintainer64/cms-labs-checker:1.0.1",
      "nodeImage": "ghcr.io/maintainer64/cms-labs-simple-task-node:1.0.3"
    }
  }
}
